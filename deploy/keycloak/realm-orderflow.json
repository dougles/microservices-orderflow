{
  "realm": "orderflow",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "buyer" },
      { "name": "ops" }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "catalog.internal",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "clients": [
    {
      "clientId": "orderflow-cli",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "company_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "company_id",
            "claim.name": "company_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "enabled": true,
      "publicClient": false,
      "secret": "${ORDER_SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic", "roles", "catalog.internal"],
      "optionalClientScopes": []
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\"},{\"name\":\"email\"}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "buyer-acme",
      "enabled": true,
      "email": "buyer-acme@orderflow.local",
      "emailVerified": true,
      "firstName": "Buyer",
      "lastName": "Acme",
      "attributes": { "company_id": ["ACME"] },
      "realmRoles": ["buyer"],
      "credentials": [{ "type": "password", "value": "buyer-acme", "temporary": false }]
    },
    {
      "username": "buyer-globex",
      "enabled": true,
      "email": "buyer-globex@orderflow.local",
      "emailVerified": true,
      "firstName": "Buyer",
      "lastName": "Globex",
      "attributes": { "company_id": ["GLOBEX"] },
      "realmRoles": ["buyer"],
      "credentials": [{ "type": "password", "value": "buyer-globex", "temporary": false }]
    },
    {
      "username": "buyer-initech",
      "enabled": true,
      "email": "buyer-initech@orderflow.local",
      "emailVerified": true,
      "firstName": "Buyer",
      "lastName": "Initech",
      "attributes": { "company_id": ["INITECH"] },
      "realmRoles": ["buyer"],
      "credentials": [{ "type": "password", "value": "buyer-initech", "temporary": false }]
    },
    {
      "username": "ops",
      "enabled": true,
      "email": "ops@orderflow.local",
      "emailVerified": true,
      "firstName": "Ops",
      "lastName": "Orderflow",
      "realmRoles": ["ops"],
      "credentials": [{ "type": "password", "value": "ops", "temporary": false }]
    }
  ]
}
